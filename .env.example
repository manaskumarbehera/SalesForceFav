# SalesForceFav — Chrome Web Store release credentials.
# Copy to .env (which is gitignored) and fill in. Used by scripts/release-chrome.mjs.

# The store item ID for SalesForceFav, from the Chrome Web Store Developer Dashboard
# URL (chrome.google.com/webstore/devconsole/.../<32-char id>/...).
# IMPORTANT: this must be SalesForceFav's OWN item — never another extension's ID.
CHROME_EXTENSION_ID=

# OAuth 2.0 "Desktop app" client from Google Cloud Console → APIs & Services →
# Credentials. One client (and one refresh token) can manage every item owned by
# the same Google developer account, so these are shared across sibling extensions.
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=

# Long-lived refresh token for the Chrome Web Store API scope. Generate once via
# the OAuth consent flow — see DOCUMENTATION/CHROME_WEBSTORE_RELEASE.md.
CHROME_REFRESH_TOKEN=

# Microsoft Edge Add-ons (Partner Center). Used by scripts/release-edge.mjs.
# EDGE_PRODUCT_ID is the product GUID; EDGE_CLIENT_ID + EDGE_API_KEY come from
# Partner Center → Publish API. See DOCUMENTATION/EDGE_ADDONS_RELEASE.md.
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
