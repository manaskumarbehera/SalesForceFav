{
  "name": "salesforcefav-extension",
  "version": "1.1.0",
  "private": true,
  "description": "SalesForceFav — a Manifest V3 Chrome/Edge extension that stores Salesforce credentials and automates login.",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run format:check && npm run lint && npm test",
    "build": "./build.sh",
    "package:chrome": "./build.sh chrome",
    "package:edge": "./build.sh edge",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "edge-extension",
    "manifest-v3",
    "salesforce",
    "credentials",
    "login"
  ],
  "author": "Manas Kumar Behera <behera.manas98@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  }
}
